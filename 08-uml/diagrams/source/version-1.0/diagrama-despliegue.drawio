<diagram id="DDEP2" name="DDEP2 - Secuencia de arranque y controles operativos"><mxGraphModel dx="1190" dy="842" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="DDEP2 - Secuencia de arranque y controles operativos&#10;Healthchecks, migraciones Liquibase, puertos y fronteras de confianza" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B70;strokeColor=#173B70;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="45" y="22" width="1090" height="45" as="geometry"/></mxCell>
<mxCell id="note" value="El backend inicia solo cuando PostgreSQL está saludable. Expo puede correr fuera de Docker durante desarrollo, pero mantiene la frontera: cliente → API, nunca cliente → base." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFE;strokeColor=#9CB4CF;fontColor=#5B6472;fontSize=8;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="45" y="795" width="1090" height="30" as="geometry"/></mxCell>
<mxCell id="order" value="Secuencia de disponibilidad" style="rounded=1;dashed=1;dashPattern=7 4;fillColor=#FFF5E0;strokeColor=#A46008;fontColor=#A46008;fontStyle=1;fontSize=10;align=right;verticalAlign=top;spacingRight=10;spacingTop=8;html=1;" parent="1" vertex="1"><mxGeometry x="45" y="130" width="700" height="555" as="geometry"/></mxCell>
<mxCell id="controls" value="Fronteras y comprobaciones" style="rounded=1;dashed=1;dashPattern=7 4;fillColor=#F1EBFF;strokeColor=#6654A8;fontColor=#6654A8;fontStyle=1;fontSize=10;align=right;verticalAlign=top;spacingRight=10;spacingTop=8;html=1;" parent="1" vertex="1"><mxGeometry x="785" y="130" width="350" height="555" as="geometry"/></mxCell>
<mxCell id="step1" value="1. PostgreSQL disponible&#10;Contenedor + volumen&#10;Usuario y base creados&#10;Healthcheck OK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4C7A21;fontColor=#253444;fontSize=9;align=center;verticalAlign=middle;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="90" y="200" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="step2" value="2. Liquibase ejecuta&#10;Migraciones aplicadas&#10;Usa la misma red de Docker&#10;Espera healthcheck de DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16735B;fontColor=#253444;fontSize=9;align=center;verticalAlign=middle;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="430" y="200" width="260" height="90" as="geometry"/></mxCell>
<mxCell id="step3" value="3. API Spring Boot lista&#10;Liquibase finalizó correctamente&#10;/api/health responde&#10;Puerto 8080 publicado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16735B;fontColor=#253444;fontSize=9;align=center;verticalAlign=middle;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="430" y="390" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="step4" value="4. Frontend web listo&#10;API URL configurada&#10;Puerto 8081 si usa Docker&#10;Muestra error si API falla" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E63A8;fontColor=#253444;fontSize=9;align=center;verticalAlign=middle;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="90" y="390" width="260" height="100" as="geometry"/></mxCell>
<mxCell id="step5" value="5. Cliente móvil conectado&#10;URL pública, IP local o túnel&#10;QR, permisos y red válidos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E63A8;fontColor=#253444;fontSize=9;align=center;verticalAlign=middle;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="260" y="555" width="260" height="78" as="geometry"/></mxCell>
<mxCell id="tls" value="Transporte seguro&#10;HTTPS/TLS en URL pública&#10;WSS para eventos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6654A8;fontColor=#253444;fontSize=9;align=center;verticalAlign=middle;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="830" y="195" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="access" value="Punto de confianza&#10;JWT, RBAC y pertenencia&#10;La API autoriza cada acción" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6654A8;fontColor=#253444;fontSize=9;align=center;verticalAlign=middle;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="830" y="320" width="260" height="76" as="geometry"/></mxCell>
<mxCell id="boundary" value="Restricciones vigentes&#10;Sin frontend → PostgreSQL&#10;Sin móvil → móvil directo&#10;Sin Firebase como backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6654A8;fontColor=#253444;fontSize=9;align=center;verticalAlign=middle;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="830" y="455" width="260" height="92" as="geometry"/></mxCell>
